#!/bin/bash
# Host wrapper for the Ubuntu lab container.
#   ./lab              open a shell as alumno (starts the container if needed)
#   ./lab <cmd...>     run any command inside the container as alumno (tools/validate*.sh, build scripts...)
#   ./lab build        (re)build the image
#   ./lab reset        destroy the container (fresh system on next start)
#   ./lab root         open a root shell
#   ./lab web          start the web UI and open http://localhost:8080
#
# LAB_INSTANCE=name   use a second, independent container ("bash-stash-name")
#                      sharing this same folder but with its own /tmp — so its
#                      checker runs never queue behind (or block) the default
#                      instance's. Handy to let someone practice in the default
#                      instance while exercises are authored/validated in a
#                      "dev" one at the same time. No web port is published for
#                      a non-default instance unless LAB_PORT is set explicitly.
set -e
case $(uname -s) in
  MINGW*|MSYS*|CYGWIN*) echo "This script needs a Linux shell. On Windows run it inside WSL (see README: Install > Windows)." >&2; exit 1 ;;
esac
HERE=$(cd "$(dirname "$0")" && pwd)
IMG=bash-stash
NAME=bash-stash${LAB_INSTANCE:+-$LAB_INSTANCE}

if command -v podman >/dev/null; then RT=podman; USERNS=(--userns=keep-id:uid=1000,gid=1000)
elif command -v docker >/dev/null; then RT=docker; USERNS=()
else echo "Need podman or docker (see README: Install)" >&2; exit 1; fi

PORT=${LAB_PORT:-8080}
PUBLISH=(); [[ -z $LAB_INSTANCE || -n ${LAB_PORT:-} ]] && PUBLISH=(-p "127.0.0.1:$PORT:8080")

build() { "$RT" build -t "$IMG" -f "$HERE/container/Containerfile" "$HERE"; }

ensure() {
  "$RT" image exists "$IMG" 2>/dev/null || "$RT" image inspect "$IMG" >/dev/null 2>&1 || build
  # (re)create the container if it is not running or was created without the wanted port
  if [[ $("$RT" inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null) != true ]] ||
     { [[ ${#PUBLISH[@]} -gt 0 ]] && ! "$RT" port "$NAME" 2>/dev/null | grep -q "127.0.0.1:$PORT\$"; }; then
    "$RT" rm -f "$NAME" >/dev/null 2>&1 || true
    "$RT" run -d --name "$NAME" --hostname labhost "${USERNS[@]}" --user root \
      "${PUBLISH[@]}" -v "$HERE:/home/alumno/lab:Z" "$IMG" >/dev/null
  fi
}

in_lab() { # [-t] cmd...
  local tty=(-i); [[ -t 0 && -t 1 ]] && tty=(-it)
  "$RT" exec "${tty[@]}" -u alumno -w /home/alumno/lab -e HOME=/home/alumno -e LAB_QUIET=1 "$NAME" \
    "$@"
}

case ${1:-} in
  build) build ;;
  web)   ensure
         if command -v curl >/dev/null; then
           for _ in $(seq 60); do curl -fs "http://127.0.0.1:$PORT/api/ping" >/dev/null 2>&1 && break; sleep 0.5; done
         else sleep 6; fi
         echo "bash stash is running at http://localhost:$PORT   (open it in your browser if it did not open by itself)"
         # the default browser: Linux (xdg-open), macOS (open), WSL (wslview or Windows' explorer.exe)
         if   grep -qi microsoft /proc/version 2>/dev/null && command -v wslview >/dev/null; then wslview "http://localhost:$PORT" >/dev/null 2>&1 &
         elif grep -qi microsoft /proc/version 2>/dev/null && command -v explorer.exe >/dev/null; then explorer.exe "http://localhost:$PORT" >/dev/null 2>&1 &
         elif command -v xdg-open >/dev/null; then xdg-open "http://localhost:$PORT" >/dev/null 2>&1 &
         elif command -v open >/dev/null; then open "http://localhost:$PORT" >/dev/null 2>&1 &
         fi
         ;;
  reset) "$RT" rm -f "$NAME" >/dev/null 2>&1; echo "container removed" ;;
  root)  ensure; shift; if (( $# )); then "$RT" exec -u root "$NAME" "$@"; else "$RT" exec -it -u root "$NAME" bash -l; fi ;;
  "")    ensure; "$RT" exec -it -u alumno -w /home/alumno/lab -e HOME=/home/alumno "$NAME" bash -l ;;
  *)     ensure; in_lab "$@" ;;
esac
