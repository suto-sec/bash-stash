#!/bin/bash
# Container entrypoint (root): restore volatile state, start cron, then idle.
# Fake logged-in sessions: `who` only lists sessions whose process is alive, so each
# one gets a real long-running process owned by that user.
sess() { # user line host date
  runuser -u "$1" -- bash -c 'exec -a -bash sleep infinity' &
  printf '[7] [%05d] [%-4s] [%-8s] [%-12s] [%-20s] [%-15s] [%s]\n' "$!" "${2#pts/}" "$1" "$2" "$3" 0.0.0.0 \
    "$(date -u -d "@$(date -d "$4" +%s)" '+%Y-%m-%dT%H:%M:%S,000000+00:00')"
}
{
  sess pruiz tty1  ""                 '2026-06-18 10:53'
  sess luke     pts/0 ":0"               '2026-06-19 15:16'
  sess sally    pts/7 callisto           '2026-06-20 13:00'
  sess rod      pts/9 remote.example.org '2026-06-20 13:22'
} > /run/utmp.txt
utmpdump -r < /run/utmp.txt > /run/utmp 2>/dev/null && chown root:utmp /run/utmp && chmod 664 /run/utmp
service cron start >/dev/null 2>&1 || cron

# Web UI (reachable only through the port ./lab publishes on 127.0.0.1).
# Each service is restarted if it dies; logs in /tmp.
runuser -l alumno -c 'while true; do
  code-server --auth none --bind-addr 127.0.0.1:8081 --disable-telemetry --disable-update-check \
    --disable-workspace-trust --disable-getting-started-override /home/alumno/lab >> /tmp/code-server.log 2>&1
  sleep 2; done' &
runuser -l alumno -c 'while true; do
  [ -f /home/alumno/lab/web/server.js ] && NODE_PATH=/opt/web/node_modules node /home/alumno/lab/web/server.js >> /tmp/web.log 2>&1
  sleep 2; done' &

exec sleep infinity
