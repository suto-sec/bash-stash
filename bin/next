#!/bin/bash
# next          show the first exercise you have not passed yet
# next <id>     show a given exercise
source "$(dirname "$(readlink -f "$0")")/../lib/engine.sh"
if [[ -n ${1:-} ]]; then d=$(ex_dir "$1") || exit 2
else
  d=
  while read -r x; do [[ -f $PROGRESS/$(ex_id "$x") ]] || { d=$x; break; }; done < <(all_ex)
  [[ -n $d ]] || { echo "${G}Everything passed. Hero status reached.${N}"; exit 0; }
fi
echo "${D}${d#$LAB/}${N}"; echo
cat "$d/README.md"
