#!/bin/bash
# progress      per-topic summary of passed exercises (no re-run)
source "$(dirname "$(readlink -f "$0")")/../lib/engine.sh"
tp=0 tt=0
for t in "$LAB"/exercises/[0-9][0-9]_*/; do
  n=0 p=0 marks=
  for d in "$t"[0-9]*_*/; do
    n=$((n+1)); id=$(ex_id "${d%/}")
    if [[ -f $PROGRESS/$id ]]; then p=$((p+1)); marks+="${G}■${N}"; else marks+="${D}□${N}"; fi
  done
  tp=$((tp+p)) tt=$((tt+n))
  printf '%-28s %3d/%-3d %s\n' "$(basename "$t")" "$p" "$n" "$marks"
done
echo "${B}total: $tp/$tt${N}"
